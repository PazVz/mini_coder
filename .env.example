# Local development only. Export this variable before running Go commands.
MINICODER_DATABASE_URL=postgres://minicoder:minicoder@127.0.0.1:5432/minicoder?sslmode=disable
MINICODER_TEST_DATABASE_URL=postgres://minicoder:minicoder@127.0.0.1:5432/minicoder_test?sslmode=disable
# Only disable Secure cookies for local HTTP. HTTPS deployments keep true (default).
MINICODER_COOKIE_SECURE=false
# Generate with: openssl rand -hex 32
# Empty disables POST /api/v1/auth/setup. Remove the value after initialization.
MINICODER_SETUP_TOKEN=
# Optional email features. Set HOST, FROM and PUBLIC_URL together.
# Public registration also requires completed administrator setup.
MINICODER_REGISTRATION_ENABLED=false
MINICODER_PUBLIC_URL=
MINICODER_SMTP_HOST=
# Empty uses 587 and starttls. For implicit TLS use port 465 and tls.
MINICODER_SMTP_PORT=
MINICODER_SMTP_TLS=
MINICODER_SMTP_USERNAME=
MINICODER_SMTP_PASSWORD=
MINICODER_SMTP_FROM=
